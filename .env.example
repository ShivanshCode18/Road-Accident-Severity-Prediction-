# ==============================================================================
# Environment Configuration Template for Road Accident Severity Prediction
# ==============================================================================
# Copy this file to .env and adjust paths to match your local installation.
# No credentials or API keys are required for this project.

# Java 8 JDK Path (Required for Apache Spark execution on Windows)
JAVA_HOME=C:\Java\jdk1.8.0_481

# Hadoop / winutils Path (Required for local Hadoop native IO on Windows)
HADOOP_HOME=C:\hadoop-3.2.4

# Apache Spark 3.5.9 Directory
SPARK_HOME=C:\Spark

# PySpark Python Interpreter (points to active virtual environment)
PYSPARK_PYTHON=venv/Scripts/python.exe
PYSPARK_DRIVER_PYTHON=venv/Scripts/python.exe

# Local Driver Network Binding
SPARK_LOCAL_IP=127.0.0.1

